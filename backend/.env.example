# ─── Database ───────────────────────────────────────────────────────────────
# Async PostgreSQL URL used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://admin:adminpassword@localhost:5432/campaign_db

# Synchronous URL used by Alembic (psycopg2 driver)
SYNC_DATABASE_URL=postgresql+psycopg2://admin:adminpassword@localhost:5432/campaign_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── AI / LLM (Google Gemini) ────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── Email — Direct SMTP / Gmail (Recommended) ──────────────────────────────
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Campaign Hub
SMTP_TLS=True

# ─── Email — Resend (Fallback) ───────────────────────────────────────────────
# Sign up at https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Campaign Hub

# ─── WhatsApp — CallMeBot (FREE) ────────────────────────────────────────────
# Docs: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_DEFAULT_PHONE=+91XXXXXXXXXX
CALLMEBOT_DEFAULT_APIKEY=your_callmebot_apikey_here
